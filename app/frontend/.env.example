# En Expo por Wi-Fi, vacio detecta la computadora de Metro y usa el puerto 8000.
# Para produccion, servidor remoto o Metro con --tunnel, configura la URL accesible del backend.
EXPO_PUBLIC_API_URL=
# ID de tu proyecto Expo para push en builds de desarrollo/produccion.
EXPO_PUBLIC_EAS_PROJECT_ID=
# production exige HTTPS y desactiva excepciones HTTP de desarrollo.
APP_ENV=development
# La API KEY de Azure Maps se coloca SOLO en ../backend/.env.
