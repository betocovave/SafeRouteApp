# COPIA ESTE ARCHIVO A .env. Nunca publiques .env.
# >>> COLOCA PERSONALMENTE TU API KEY DE AZURE MAPS AQUI <<<
AZURE_MAPS_API_KEY=
AZURE_MAPS_AUTH_MODE=key
# Alternativa: AZURE_MAPS_AUTH_MODE=sas y tu token en la siguiente variable.
AZURE_MAPS_SAS_TOKEN=
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
DATABASE_URL=postgresql+psycopg://saferoute:saferoute@localhost:5432/saferoute
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8081
# Azurite: el script infrastructure/setup.ps1 escribe la cadena local oficial.
# Produccion: coloca aqui la cadena de tu cuenta Blob.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=incident-photos
ENABLE_JOBS=true
EXPO_ACCESS_TOKEN=
